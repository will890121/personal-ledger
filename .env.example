TELEGRAM_BOT_TOKEN=
LEDGER_OWNER_ID=
DATABASE_PATH=./data/personal-ledger.sqlite
TZ=Asia/Taipei
LEDGER_CURRENCY=TWD

# Google Sheets 鏡像（選填）。兩個是一組的：兩個都填才會啟用，兩個都不填就整個關閉，
# 只填一半會拒絕啟動（刻意如此，見 src/config.ts）。
#
# 要啟用就把下面兩行的 # 拿掉並填值。**不啟用就保持註解狀態，不要留成空值**——
# 空字串是「有設定但值不合法」，compose 與 docker run --env-file 都會把它照實傳進
# 容器，啟動時會以 `Invalid configuration: GOOGLE_SERVICE_ACCOUNT_KEY_FILE` 中止。
#
# 金鑰檔路徑寫的是**容器內**的路徑：主機的 ./secrets 以唯讀掛載到容器的 /app/secrets
# （見 compose.yaml）。本機 pnpm dev 直接跑的話才用主機路徑 ./secrets/....json。
#GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/app/secrets/google-service-account.json
#SHEET_SPREADSHEET_ID=
